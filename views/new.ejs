<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add new user</title>
</head>
<body>
    <form action="/user" method="POST">
       <textarea name="username" placeholder="Enter your username" row="10" column="25"></textarea>
       <br><br><br>       
       <input name="email" placeholder="Enter your email id">
       <br><br><br>
       <input name="password" placeholder="Enter your password" type="password">
       <br><br><br>
       <button type="submit">Submit</button>
    </form>
</body>
</html>